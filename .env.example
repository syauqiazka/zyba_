# Ambil dari Neon dashboard -> Connection Details
# Pakai connection string yang "pooled" (pgbouncer) untuk runtime app,
# dan yang "direct" khusus untuk migrasi Prisma.

# Dipakai oleh app saat runtime (lewat PgBouncer, cocok untuk serverless/Vercel)
DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/zyba?sslmode=require"

# Dipakai khusus oleh Prisma saat migrate/push (koneksi langsung, tanpa pooler)
DIRECT_URL="postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/zyba?sslmode=require"

NEXTAUTH_SECRET="ganti-dengan-random-string-panjang"
NEXTAUTH_URL="http://localhost:3000"

# =========================================================================
# Email OTP Delivery Configuration (Nodemailer / Gmail / SMTP / Resend)
# =========================================================================
# Opsi 1 (Paling Mudah): Gmail App Password
# Buat 16-digit App Password di Google Account -> Keamanan -> Verifikasi 2 Langkah -> Sandi Aplikasi
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# Opsi 2: Custom SMTP (Brevo, SendGrid, Mailgun, cPanel, dll)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER="your-smtp-user"
# SMTP_PASS="your-smtp-password"
# SMTP_SECURE=false

# Opsi 3: Resend API (Opsional jika menggunakan https://resend.com)
# RESEND_API_KEY="re_xxxxxxxxxxxx"
# EMAIL_FROM="ZYBA Wellness <onboarding@resend.dev>"

