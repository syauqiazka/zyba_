# ── Database (Self-Hosted PostgreSQL Webuzo — Lampiran E.1) ──
# Di server mandiri (Webuzo "Manage PostgreSQL"), database account, companion, dan community
# dibuat terpisah di localhost. Karena tidak butuh connection pooler khusus (seperti PgBouncer di Neon),
# DATABASE_URL_* dan DIRECT_URL_* nilainya sama persis:
DATABASE_URL_ACCOUNT="postgresql://<db_user>:<db_pass>@localhost:5432/zyba_account"
DIRECT_URL_ACCOUNT="postgresql://<db_user>:<db_pass>@localhost:5432/zyba_account"

DATABASE_URL_COMPANION="postgresql://<db_user>:<db_pass>@localhost:5432/zyba_companion"
DIRECT_URL_COMPANION="postgresql://<db_user>:<db_pass>@localhost:5432/zyba_companion"

DATABASE_URL_COMMUNITY="postgresql://<db_user>:<db_pass>@localhost:5432/zyba_community"
DIRECT_URL_COMMUNITY="postgresql://<db_user>:<db_pass>@localhost:5432/zyba_community"

# ── Alternatif: Cloud Neon Postgres (jika masih menggunakan cloud serverless) ──
# DATABASE_URL_ACCOUNT="postgresql://<user>:<pass>@<ep>-pooler.<region>.aws.neon.tech/account?sslmode=require"
# DIRECT_URL_ACCOUNT="postgresql://<user>:<pass>@<ep>.<region>.aws.neon.tech/account?sslmode=require"
# DATABASE_URL_COMPANION="postgresql://<user>:<pass>@<ep>-pooler.<region>.aws.neon.tech/companion?sslmode=require"
# DIRECT_URL_COMPANION="postgresql://<user>:<pass>@<ep>.<region>.aws.neon.tech/companion?sslmode=require"
# DATABASE_URL_COMMUNITY="postgresql://<user>:<pass>@<ep>-pooler.<region>.aws.neon.tech/community?sslmode=require"
# DIRECT_URL_COMMUNITY="postgresql://<user>:<pass>@<ep>.<region>.aws.neon.tech/community?sslmode=require"

# ── AI Text Providers (Bagian 19.1) ──
GEMINI_API_KEY=""           # https://aistudio.google.com/apikey
GROQ_API_KEY=""             # https://console.groq.com/keys  (juga untuk STT Whisper)
MISTRAL_API_KEY=""          # https://console.mistral.ai/
OPENROUTER_API_KEY=""       # https://openrouter.ai/keys

# ── AI Voice (Bagian 19.2) ──
# STT: pakai GROQ_API_KEY, tidak perlu key terpisah
# TTS PRIMARY: ElevenLabs (recommended), fallback: browser Web Speech API
ELEVENLABS_API_KEY=""       # https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_DEFAULT_VOICE_ID="21m00Tcm4TlvDq8ikWAM"  # Rachel (default), browse: elevenlabs.io/app/voice-library

# ── Storage (Lampiran E.3 — Self-Hosted Filesystem) ──
# Di server zyba.my.id, file upload disimpan otomatis ke filesystem: public/uploads/ dan public/uploads/avatars/
# BLOB_READ_WRITE_TOKEN opsional — kosongkan jika menggunakan storage filesystem lokal
BLOB_READ_WRITE_TOKEN=""

# ── Realtime (Bagian 31.D Community DM) ──
ABLY_API_KEY=""             # https://ably.com/accounts (create app, copy API key)

# ── Auth & Domain (Lampiran E.4) ──
NEXTAUTH_SECRET="ganti-dengan-random-string-rahasia-panjang"
NEXTAUTH_URL="https://jhic.zyba.my.id" # Untuk development lokal: "http://localhost:3000"

# ── Google OAuth (Bagian 8.6 & E.4) ──
# Redirect URI di Google Cloud Console: https://jhic.zyba.my.id/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Email OTP ──
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# ── Payment Gateway Midtrans (Bagian 26 & E.4) ──
# Notification URL di dashboard.midtrans.com > Settings > Configuration:
# https://jhic.zyba.my.id/api/billing/webhook
MIDTRANS_SERVER_KEY=""              # dari dashboard.midtrans.com > Settings > Access Keys (Sandbox)
MIDTRANS_CLIENT_KEY=""              # dari dashboard.midtrans.com > Settings > Access Keys (Sandbox)
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=""  # sama dengan MIDTRANS_CLIENT_KEY (dipakai client-side Snap.js)
MIDTRANS_IS_PRODUCTION="false"      # tetap false untuk demo/kompetisi

# ── Server Actions (Lampiran E.6 — self-hosted) ──
# Domain production diizinkan untuk Server Actions, dipisahkan koma
ALLOWED_ORIGINS="jhic.zyba.my.id,zyba.my.id,www.zyba.my.id"
