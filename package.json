{
  "name": "zyba-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:migrate": "prisma migrate dev",
    "db:seed": "ts-node prisma/seed.ts",
    "db:push:account": "prisma db push --schema=prisma/account/schema.prisma",
    "db:push:companion": "prisma db push --schema=prisma/companion/schema.prisma",
    "db:push:community": "prisma db push --schema=prisma/community/schema.prisma",
    "db:push:all": "npm run db:push:account && npm run db:push:companion && npm run db:push:community",
    "db:generate:all": "prisma generate --schema=prisma/account/schema.prisma && prisma generate --schema=prisma/companion/schema.prisma && prisma generate --schema=prisma/community/schema.prisma",
    "ai:models-test": "node scripts/test-ai-models.js"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\\\"module\\\":\\\"CommonJS\\\"} prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "@types/bcryptjs": "^3.0.0",
    "ably": "^2.28.0",
    "bcryptjs": "^3.0.3",
    "elevenlabs": "^1.59.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.47.0",
    "next": "14.2.15",
    "nodemailer": "^10.0.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.11.0",
    "postcss": "^8.4.47",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.13",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9"
}
