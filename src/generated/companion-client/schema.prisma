generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
  output        = "../../src/generated/companion-client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL_COMPANION")
  directUrl = env("DIRECT_URL_COMPANION")
}

model Conversation {
  id         String   @id @default(cuid())
  userId     String // TANPA @relation — user ada di Account DB
  title      String   @default("New Conversation")
  emotionTag String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  messages Message[]

  @@index([userId])
  @@map("conversations")
}

model Message {
  id               String       @id @default(cuid())
  conversationId   String
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role             String
  content          String?
  modelUsed        String?
  attachmentType   String?
  attachmentUrl    String?
  audioDurationSec Int?
  stickerId        String?
  flaggedForRisk   Boolean      @default(false)
  ttsAudioUrl      String?
  ttsProvider      String?
  ttsModel         String?
  ttsGeneratedAt   DateTime?
  createdAt        DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([role, createdAt, conversationId])
  @@map("messages")
}
