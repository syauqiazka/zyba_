generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
  output   = "../../src/generated/companion-client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL_COMPANION")
  directUrl = env("DIRECT_URL_COMPANION")
}

model Conversation {
  id         String   @id @default(cuid())
  userId     String   // TANPA @relation — user ada di Account DB
  title      String   @default("New Conversation")
  emotionTag String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  messages Message[]

  @@index([userId])
  @@map("conversations")
}

model Message {
  id               String       @id @default(cuid())
  conversationId   String
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role             String       // "USER" | "ASSISTANT"
  content          String?      // opsional kalau isinya cuma media
  modelUsed        String?      // AI model yang dipakai (gemini-3.8-flash, llama-3.3-70b, dll)
  attachmentType   String?      // "image" | "audio" | "sticker" | null
  attachmentUrl    String?      // URL object storage, BUKAN base64
  audioDurationSec Int?
  stickerId        String?
  flaggedForRisk   Boolean      @default(false)
  ttsAudioUrl      String?      // Cached TTS audio dari ElevenLabs/Edge
  ttsProvider      String?      // "elevenlabs" | "edge" | "browser"
  ttsModel         String?      // Model yang digunakan (eleven_flash_v2_5)
  ttsGeneratedAt   DateTime?    // Kapan audio di-generate
  createdAt        DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@map("messages")
}
