generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
  output   = "../../src/generated/account-client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL_ACCOUNT")
  directUrl = env("DIRECT_URL_ACCOUNT")
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  username     String? @unique
  passwordHash String
  name         String
  avatarUrl    String?
  phone        String?
  location     String?
  bio          String?

  companionPersona CompanionPersona @default(KINA)
  plan             Plan             @default(FREE)

  onboardingCompleted Boolean @default(false)
  zybaScore           Int?
  stressLevel         Int?
  streak              Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assessment       Assessment?
  moodEntries      MoodEntry[]
  dailyAssessments DailyAssessment[]
  journalEntries   JournalEntry[]
  activities       ActivityLog[]
  notificationPref NotificationPref?
  subscriptions    Subscription[]
  userAchievements UserAchievement[]
  userBadges       UserBadge[]
  streakDays       Int?             @default(0)
  lastStreakDate   DateTime?

  @@map("users")
}

// FASE 4: ganti CommunicationStyle → CompanionPersona (mapping 1:1)
enum CompanionPersona {
  KINA  // dulu CASUAL
  OLLIE // dulu FORMAL
  RUBI  // dulu FUN
  BRUNO // baru
}

enum Plan {
  FREE
  PLUS
}

model NotificationPref {
  id             String  @id @default(cuid())
  userId         String  @unique
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  companionNotif Boolean @default(true)
  wellnessNotif  Boolean @default(true)
  communityNotif Boolean @default(false)

  @@map("notification_prefs")
}

model Assessment {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  goal                 String?
  gender               String?
  age                  Int?
  weightKg             Float?
  initialMood          MoodLevel?
  soughtHelpBefore     Boolean?
  physicalSymptoms     String[]
  sleepQualityRating   Int?
  stressLevel          Int?
  medications          String?
  mentalHealthSymptoms String[]
  expressionText       String?
  flaggedForRisk       Boolean    @default(false)

  createdAt DateTime @default(now())

  @@map("assessments")
}

enum MoodLevel {
  DEPRESSED
  SAD
  NEUTRAL
  HAPPY
  OVERJOYED
}

model MoodEntry {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mood        MoodLevel
  stressLevel Int?
  note        String?
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("mood_entries")
}

model DailyAssessment {
  id              String    @id @default(cuid())
  userId          String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  date            String
  mood            MoodLevel
  stressLevel     Int?
  sleepRating     Int?
  energyTags      String[]
  reflection      String?
  flaggedForRisk  Boolean   @default(false)

  // ⭐ SCORE HARIAN
  calculatedScore Int?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, date])
  @@index([userId, createdAt])
  @@map("daily_assessments")
}

model JournalEntry {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String
  mood      MoodLevel?
  createdAt DateTime   @default(now())

  @@index([userId, createdAt])
  @@map("journal_entries")
}

enum ActivityType {
  WALKING
  RUNNING
  WORKOUT
  BREATHING
  SLEEP
}

model ActivityLog {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          ActivityType
  durationMin   Int?
  distanceMeter Int?
  targetMin     Int?
  completed     Boolean      @default(false)
  createdAt     DateTime     @default(now())

  @@index([userId, createdAt])
  @@map("activity_logs")
}

enum ResourceType {
  ARTICLE
  COURSE
}

model Resource {
  id          String       @id @default(cuid())
  type        ResourceType
  title       String
  author      String?
  coverUrl    String?
  durationMin Int?
  body        String?
  isPro       Boolean      @default(false)
  createdAt   DateTime     @default(now())

  @@map("resources")
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      Plan
  status    SubscriptionStatus @default(PENDING)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime           @default(now())
  payments  Payment[]

  @@index([userId])
  @@map("subscriptions")
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

model Payment {
  id             String        @id @default(cuid())
  subscriptionId String
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id])
  userId         String
  amount         Int
  provider       String        @default("midtrans")
  orderId        String        @unique
  transactionId  String?
  paymentMethod  String?
  status         PaymentStatus @default(PENDING)
  rawPayload     Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId, createdAt])
  @@map("payments")
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
  CANCELLED
}

// ---------- ACHIEVEMENTS & BADGES ----------

enum AchievementCategory {
  STREAK      // daily login/mood check-in streaks
  WELLNESS    // mood & journal milestones
  SOCIAL      // community engagement
  COMPANION   // chat interactions
  ACTIVITY    // physical activity
  SPECIAL     // rare/event-based
}

model Achievement {
  id          String              @id @default(cuid())
  key         String              @unique  // e.g. "streak_7", "mood_30"
  title       String
  description String
  icon        String              // emoji or icon name
  category    AchievementCategory
  threshold   Int?                // numeric threshold to unlock
  isSecret    Boolean             @default(false)
  xpReward    Int                 @default(10)

  userAchievements UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  unlockedAt    DateTime    @default(now())
  seen          Boolean     @default(false)

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

// User-customizable badges shown on their profile
model UserBadge {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slot        Int      // display slot index 0-2 (up to 3 pinned badges)
  badgeKey    String   // references Achievement.key
  customLabel String?  // optional user rename
  updatedAt   DateTime @updatedAt

  @@unique([userId, slot])
  @@map("user_badges")
}
