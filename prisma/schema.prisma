// ZYBA — Prisma schema
// Database: Neon Postgres (serverless)
// Jalankan `npm run db:push` untuk sinkronisasi pertama kali (tanpa migration history),
// atau `npm run db:migrate` kalau mau migration file tersimpan (rekomendasi untuk produksi).

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")   // pooled connection, dipakai runtime
  directUrl = env("DIRECT_URL")     // direct connection, dipakai migrate/push
}

// ---------- USER & AUTH ----------

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String
  avatarUrl     String?
  phone         String?
  location      String?
  bio           String?

  communicationStyle CommunicationStyle @default(FORMAL)
  plan               Plan               @default(FREE)

  onboardingCompleted Boolean @default(false)
  zybaScore            Int?    // skor awal dari onboarding assessment

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assessment         Assessment?
  moodEntries        MoodEntry[]
  dailyAssessments   DailyAssessment[]
  journalEntries     JournalEntry[]
  activities         ActivityLog[]
  conversations      Conversation[]
  posts              CommunityPost[]
  comments           CommunityComment[]
  notificationPref   NotificationPref?
  userAchievements   UserAchievement[]
  userBadges         UserBadge[]
  streakDays         Int      @default(0)   // consecutive days
  lastStreakDate     DateTime?

  @@map("users")
}

enum CommunicationStyle {
  CASUAL
  FORMAL
  FUN
}

enum Plan {
  FREE
  PLUS
}

model NotificationPref {
  id                  String  @id @default(cuid())
  userId              String  @unique
  user                User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  companionNotif      Boolean @default(true)
  wellnessNotif       Boolean @default(true)
  communityNotif      Boolean @default(false)

  @@map("notification_prefs")
}

// ---------- ONBOARDING ASSESSMENT ----------
// Hasil kuisioner kesehatan mental awal (bagian C di AGENTS.md)

model Assessment {
  id       String @id @default(cuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  goal                String?
  gender              String?
  age                 Int?
  weightKg            Float?
  initialMood         MoodLevel?
  soughtHelpBefore     Boolean?
  physicalSymptoms    String[]  // multi-select disimpan sebagai array
  sleepQualityRating  Int?      // 1-5
  stressLevel         Int?      // 1-5
  medications         String?
  mentalHealthSymptoms String[]

  // Free-text refleksi pengguna. Lihat catatan keamanan di bawah.
  expressionText      String?
  // Ditandai true oleh crisis-detection service (bukan oleh UI) jika
  // expressionText terindikasi risiko bahaya diri. Dipakai untuk memicu
  // alur eskalasi, BUKAN untuk ditampilkan sebagai skor/gamifikasi.
  flaggedForRisk      Boolean  @default(false)

  createdAt DateTime @default(now())

  @@map("assessments")
}

// ---------- MOOD CHECK-IN ----------
// Check-in cepat & ringan: mood + opsional stress/catatan.
// Bisa dilakukan lebih dari sekali per hari (timestamp nyata dicatat).

enum MoodLevel {
  DEPRESSED
  SAD
  NEUTRAL
  HAPPY
  OVERJOYED
}

model MoodEntry {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mood        MoodLevel
  stressLevel Int?      // 1-5, opsional
  note        String?   // catatan singkat opsional
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("mood_entries")
}

// ---------- ASSESSMENT HARIAN ----------
// Evaluasi kondisi user per hari — lebih lengkap dari Mood Check-In.
// Satu record per user per hari (@@unique), bisa di-update (upsert).

model DailyAssessment {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          String    // "YYYY-MM-DD" — key per hari
  mood          MoodLevel
  stressLevel   Int?      // 1-5
  sleepRating   Int?      // 1-5
  energyTags    String[]  // multi-select kondisi hari ini
  reflection    String?   // free-text refleksi harian
  flaggedForRisk Boolean  @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, date])
  @@index([userId, createdAt])
  @@map("daily_assessments")
}

// ---------- HEALTH / MENTAL JOURNAL ----------

model JournalEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String
  mood      MoodLevel?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("journal_entries")
}

// ---------- SMART ACTIVITY PLANNER ----------

enum ActivityType {
  WALKING
  RUNNING
  WORKOUT
  BREATHING
  SLEEP
}

model ActivityLog {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         ActivityType
  durationMin  Int?
  distanceMeter Int?
  targetMin    Int?
  completed    Boolean      @default(false)
  createdAt    DateTime     @default(now())

  @@index([userId, createdAt])
  @@map("activity_logs")
}

// ---------- ZYBA COMPANION (AI CHAT) ----------

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("New Conversation")
  emotionTag String? // hasil deteksi emosi otomatis dari isi chat
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@map("conversations")
}

enum MessageRole {
  USER
  ASSISTANT
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String
  // Ditandai true oleh crisis-detection service jika pesan USER terindikasi
  // risiko bahaya diri. Route API akan memicu alur eskalasi terpisah.
  flaggedForRisk Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ---------- ZYBA COMMUNITY ----------

model CommunityPost {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  imageUrl  String?
  createdAt DateTime @default(now())

  comments CommunityComment[]
  likes    CommunityLike[]

  @@index([createdAt])
  @@map("community_posts")
}

model CommunityComment {
  id        String        @id @default(cuid())
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime      @default(now())

  @@map("community_comments")
}

model CommunityLike {
  id     String        @id @default(cuid())
  postId String
  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String

  @@unique([postId, userId])
  @@map("community_likes")
}

// ---------- RESOURCES (Articles & Courses) ----------

enum ResourceType {
  ARTICLE
  COURSE
}

model Resource {
  id          String       @id @default(cuid())
  type        ResourceType
  title       String
  author      String?
  coverUrl    String?
  durationMin Int?
  body        String?
  isPro       Boolean      @default(false)
  createdAt   DateTime     @default(now())

  @@map("resources")
}

// ---------- ACHIEVEMENTS & BADGES ----------

enum AchievementCategory {
  STREAK      // daily login/mood check-in streaks
  WELLNESS    // mood & journal milestones
  SOCIAL      // community engagement
  COMPANION   // chat interactions
  ACTIVITY    // physical activity
  SPECIAL     // rare/event-based
}

model Achievement {
  id          String              @id @default(cuid())
  key         String              @unique  // e.g. "streak_7", "mood_30"
  title       String
  description String
  icon        String              // emoji or icon name
  category    AchievementCategory
  threshold   Int?                // numeric threshold to unlock
  isSecret    Boolean             @default(false)
  xpReward    Int                 @default(10)

  userAchievements UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  unlockedAt    DateTime    @default(now())
  seen          Boolean     @default(false)

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

// User-customizable badges shown on their profile
model UserBadge {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slot        Int      // display slot index 0-2 (up to 3 pinned badges)
  badgeKey    String   // references Achievement.key
  customLabel String?  // optional user rename
  updatedAt   DateTime @updatedAt

  @@unique([userId, slot])
  @@map("user_badges")
}
